@model Practica1PrograWebRegistroTecnologico.Models.EquipoTecnologico

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h4 class="mb-0"><i class="bi bi-laptop me-2"></i>Registro de Equipo Tecnológico</h4>
                </div>
                <div class="card-body p-4">

                    <form asp-action="CrearEquipoTecnologico" method="post">
                        <div class="form-group">
                            <input asp-for="Id" type="hidden" value="0" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Nombre"></label>
                            <input asp-for="Nombre" class="form-control" />
		                    <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>
                        <div class="form-group">    
                            <label asp-for="Marca"></label>
                            <input asp-for="Marca" class="form-control" />
		                    <span asp-validation-for="Marca" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Precio"></label>
                            <input asp-for="Precio" class="form-control" />
                            <span asp-validation-for="Precio" class="text-danger"></span>   
                        </div>
                        <div class="form-group">
                            <label asp-for="CodigoInventario"></label>
                            <input asp-for="CodigoInventario" class="form-control" />
		                    <span asp-validation-for="CodigoInventario" class="text-danger"></span>
                        </div>
                        <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">Crear</button>
						</div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
