@model Practica1PrograWebRegistroTecnologico.Models.EquipoTecnologico

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-success shadow-sm">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">¡Registro Exitoso!</h4>
                </div>
                <div class="card-body">
                    <p class="lead text-center text-success fw-bold">El equipo se ha procesado correctamente.</p>
                    <hr />
                    <dl class="row fs-5">

                        <dt class="col-sm-4 text-muted">Nombre:</dt>
                        <dd class="col-sm-8">@Model.Nombre</dd>

                        <dt class="col-sm-4 text-muted">Marca:</dt>
                        <dd class="col-sm-8">@Model.Marca</dd>

                        <dt class="col-sm-4 text-muted">Precio:</dt>
                        <dd class="col-sm-8">@Model.Precio</dd>

                        <dt class="col-sm-4 text-muted">Código Inventario:</dt>
                        <dd class="col-sm-8">@Model.CodigoInventario</dd>
                    </dl>
                </div>
                <div class="card-footer text-end bg-light">
                    <a asp-action="CrearEquipoTecnologico" class="btn btn-outline-success">Registrar otro equipo</a>
                </div>
            </div>
        </div>
    </div>
</div>
